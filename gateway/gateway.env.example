# Copy to ~/.config/himmel-voice/gateway.env (untracked). The token is not here: it lives in the keyring.
VOICE_GATEWAY_VAULT=/path/to/luna
VOICE_GATEWAY_BIND=192.0.2.10
# The fence reads its own copy of these two from /etc/himmel-voice/docker-user.env: change both together.
VOICE_GATEWAY_PORT=8740
HA_HOST=192.0.2.5
# Vault subdirectories /search may read, colon-separated. Whatever it returns goes to cloud LLMs.
VOICE_GATEWAY_SEARCH_DIRS=00-Inbox/voice
# The himmel bridge state dir whose consoles/ holds the chief inboxes /chief appends to. Optional;
# unset means ~/.claude/handover/bridge, where himmel's chiefs arm their inboxes.
# VOICE_GATEWAY_BRIDGE_ROOT=/path/to/bridge
